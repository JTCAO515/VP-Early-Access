# ---------------------------------------------------------------------------
# Waitlist storage provider.
#   console  - dev only, prints submissions to the server log. No setup needed.
#   feishu   - writes each submission into a Feishu / Lark Bitable table.
#   webhook  - POSTs the raw JSON payload to WAITLIST_WEBHOOK_URL.
# ---------------------------------------------------------------------------
WAITLIST_PROVIDER=console

# --- feishu provider -------------------------------------------------------
# open.feishu.cn  -> mainland China tenant (feishu.cn)
# open.larksuite.com -> international tenant (larksuite.com)
FEISHU_DOMAIN=open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# --- webhook provider ------------------------------------------------------
WAITLIST_WEBHOOK_URL=

# Public site URL, used for canonical + Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://early.visepanda.com
